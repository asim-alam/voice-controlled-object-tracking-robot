# Set these in your shell before starting voice_bridge.py.
VROD_ESP32_IP=192.168.1.100
VROD_PC_IP=192.168.1.10

# Optional: enables conversational responses when no robot command is found.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
